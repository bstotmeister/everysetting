-- Lint config for the WoW client's Lua 5.1 environment. Run: luacheck EverySetting tests
std = "lua51"
max_line_length = false
unused_args = false -- WoW callbacks get arguments they don't always need

-- Globals EverySetting defines.
globals = {
	"EverySetting",
	"EverySettingDB",
	"EverySettingCharDB",
	"EverySetting_OpenOptions",
	"EverySetting_OnAddonCompartmentClick",
	"EverySetting_OnAddonCompartmentEnter",
	"EverySetting_OnAddonCompartmentLeave",
	"BINDING_HEADER_EVERYSETTING",
	"BINDING_NAME_EVERYSETTING_TOGGLE",
	"BINDING_NAME_EVERYSETTING_UNDO",
	"SLASH_EVERYSETTING1",
	"SLASH_EVERYSETTING2",
	"SLASH_EVERYSETTING3",
	"SLASH_EVERYSETTINGKUI1",
	"hash_SlashCmdList",
	"SlashCmdList",
}

-- WoW API it reads. Add new ones here as the addon starts using them.
read_globals = {
	"C_AddOns",
	"C_ColorOverrides",
	"C_CombatAudioAlert",
	"C_CVar",
	"C_KeyBindings",
	"C_Minimap",
	"C_SocialRestrictions",
	"C_Timer",
	"ChatConfigFrame_OnChatDisabledChanged",
	"ColorPickerFrame",
	"ConsoleExec",
	"ConsoleGetAllCommands",
	"ConsoleGetColorFromType",
	"ConsoleGetFontHeight",
	"CreateColorFromHexString",
	"CreateFrame",
	"debugstack",
	"DEFAULT_CHAT_FRAME",
	"Enum",
	"EverySettingOptions",
	"GameEvent",
	"GameTooltip",
	"GetActionBarToggles",
	"GetAllowRecentAlliesSeeLocation",
	"GetAutoDeclineGuildInvites",
	"GetBuildInfo",
	"GetCameraZoom",
	"GetCurrentBindingSet",
	"GetCursorPosition",
	"GetFramerate",
	"GetLocale",
	"GetModifiedClick",
	"GetPlayerFacing",
	"GetTime",
	"GetUnitSpeed",
	"hooksecurefunc",
	"InCombatLockdown",
	"IsFalling",
	"IsGraphicsCVarValueSupported",
	"IsInInstance",
	"IsMounted",
	"IsMouseButtonDown",
	"IsMouselooking",
	"IsResting",
	"MenuUtil",
	"ResetTestCvars",
	"RestartGx",
	"SaveBindings",
	"SetActionBarToggles",
	"SetAllowRecentAlliesSeeLocation",
	"SetAutoDeclineGuildInvites",
	"SetModifiedClick",
	"Settings",
	"SettingsPanel",
	"StaticPopup_Hide",
	"StaticPopup_Show",
	"UIParent",
	"UISpecialFrames",
	"UnitAffectingCombat",
	"UpdateWindow",
	"WOW_PROJECT_ID",
	"WOW_PROJECT_MAINLINE",
	"strsplit",
	"strtrim",
	"tinsert",
	"wipe",
}

-- The tests run outside the game, on plain Lua 5.1 to 5.5.
files["tests"] = {
	std = "max",
	globals = { "EverySettingDB", "EverySettingCharDB", "SlashCmdList" },
	read_globals = { "C_CVar", "CreateFrame", "EverySettingOptions", "EverySettingPanel", "EverySetting_OpenOptions", "ResetTestCvars", "SetCVar", "StaticPopup_Show" },
}
